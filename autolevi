_G.SenakaCharacterMove = function(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    speed = speed or _G.Config.TweenSpeed
    local noclipConn = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    hum.PlatformStand = true
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = distance / speed
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})

    tween:Play()
    tween.Completed:Wait()
    if noclipConn then noclipConn:Disconnect() end
    hum.PlatformStand = false
end

local function GetPlayerBoat()
    for _, obj in pairs(workspace:GetChildren()) do
        if obj:IsA("Model") then
            local ownerVal = obj:FindFirstChild("Owner")
            if obj.Name:find(LocalPlayer.Name) or (ownerVal and tostring(ownerVal.Value) == LocalPlayer.Name) then
                return obj
            end
        end
    end
    return nil
end

local function FindAndInteractBoatDealer()
    local dealerPart = nil
    
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower():find("boatdealer") or obj.Name:lower():find("dealer") or obj.Name:lower():find("boat")) then
            if obj:FindFirstChild("HumanoidRootPart") then
                dealerPart = obj.HumanoidRootPart
                break
            end
        end
    end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")

    if dealerPart and root then
        if (dealerPart.Position - root.Position).Magnitude > 12 then
            _G.SenakaCharacterMove(dealerPart.CFrame * CFrame.new(0, 3, 3), _G.Config.TweenSpeed)
            task.wait(0.6)
        end
    end

    local boatName = _G.Config.SelectedBoat or "Dinghy"
    
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", boatName)
    end)
    task.wait(0.5)
    
    pcall(function()
        ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", tostring(boatName))
    end)
    task.wait(1.5)
end

local processedBoats = {}
local function SecureBoatPhysics(boatModel)
    if not boatModel or processedBoats[boatModel] then return end
    processedBoats[boatModel] = true
    
    task.spawn(function()
        task.wait(0.3)
        pcall(function()
            for _, part in pairs(boatModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                    part.CanCollide = true
                end
            end
        end)
    end)
end

local function CountPlayersOnBoat(boatModel)
    if not boatModel then return 0 end
    local count = 0
    local countedPlayers = {}

    for _, desc in pairs(boatModel:GetDescendants()) do
        if desc:IsA("Seat") or desc:IsA("VehicleSeat") then
            if desc.Occupant and desc.Occupant.Parent then
                local player = Players:GetPlayerFromCharacter(desc.Occupant.Parent)
                if player and not countedPlayers[player] then
                    countedPlayers[player] = true
                    count = count + 1
                end
            end
        end
    end

    local boatPart = boatModel.PrimaryPart or boatModel:FindFirstChildWhichIsA("BasePart")
    if boatPart then
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                if not countedPlayers[p] then
                    local dist = (p.Character.HumanoidRootPart.Position - boatPart.Position).Magnitude
                    if dist < 40 then
                        countedPlayers[p] = true
                        count = count + 1
                    end
                end
            end
        end
    end

    return count
end

