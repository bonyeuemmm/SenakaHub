_G.SenakaCharacterMove = function(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    speed = speed or _G.Config.TweenSpeed
    local noclipConn = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    hum.PlatformStand = true
    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = distance / speed
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})

    tween:Play()
    tween.Completed:Wait()
    if noclipConn then noclipConn:Disconnect() end
    hum.PlatformStand = false
end

local function GetPlayerBoat()
    local boatsFolder = workspace:FindFirstChild("Boats")
    if boatsFolder then
        for _, boat in pairs(boatsFolder:GetChildren()) do
            local owner = boat:FindFirstChild("Owner")
            if owner then
                if typeof(owner.Value) == "Instance" and owner.Value == LocalPlayer then return boat end
                if tostring(owner.Value) == LocalPlayer.Name then return boat end
            end
        end
    end
    return nil
end

local lastBuyTime = 0
local function FindAndInteractBoatDealer()
    if tick() - lastBuyTime < 10 then return end
    local dealerPart = nil
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:lower() == "boat dealer" or obj.Name:lower():find("boatdealer")) then
            if obj:FindFirstChild("HumanoidRootPart") then
                dealerPart = obj.HumanoidRootPart
                break
            end
        end
    end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if dealerPart and root then
        if (dealerPart.Position - root.Position).Magnitude > 10 then
            _G.SenakaCharacterMove(dealerPart.CFrame * CFrame.new(0, 3, 3), _G.Config.TweenSpeed)
            task.wait(0.5)
        end
    end
    pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", _G.Config.SelectedBoat or "Dinghy") end)
    lastBuyTime = tick()
    task.wait(3)
end

