local function SmartBuyBoat()
    local boatList = {"Sleigh", "Mirage", "FlowerBoat", "Speedboat", "Dinghy"}
    for _, boat in ipairs(boatList) do
        local success, res = pcall(function()
            return ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", boat)
        end)
        if success and res and res ~= "Failed" then
            _G.SenakaSendNotification("Mua Thuyền", "Thành công: " .. boat)
            return true
        end
    end
    return false
end

spawn(function()
    while true do
        task.wait(0.4)
        
        local Char = LocalPlayer.Character
        local Hum = Char and Char:FindFirstChild("Humanoid")
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")

        if _G.Config.WaterWalk and Root then
            pcall(function()
                if Root.Position.Y < 4 and Root.Position.Y > -100 then
                    local existingPlatform = workspace:FindFirstChild("WaterPlatform_" .. LocalPlayer.Name)
                    if not existingPlatform then
                        local p = Instance.new("Part")
                        p.Name = "WaterPlatform_" .. LocalPlayer.Name
                        p.Size = Vector3.new(14, 1, 14)
                        p.Anchored = true
                        p.Transparency = 1
                        p.CanCollide = true
                        p.CFrame = CFrame.new(Root.Position.X, 1.5, Root.Position.Z)
                        p.Parent = workspace
                        task.delay(0.6, function() if p then p:Destroy() end end)
                    else
                        existingPlatform.CFrame = CFrame.new(Root.Position.X, 1.5, Root.Position.Z)
                    end
                end
            end)
        end

        if _G.Config.AutoBuso and Char then
            pcall(function()
                if not Char:FindFirstChild("HasBuso") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
                end
            end)
        end

        if _G.Config.AutoV3V4 then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
            end)
        end

        local isAvoidingEvent = false
        if _G.Config.AutoAvoidSeaEvent and Root then
            pcall(function()
                local seaMonsters = {"SeaBeast", "TerrorShark", "Piranha", "ShipRaid", "SeaMonster"}
                for _, obj in pairs(workspace:GetChildren()) do
                    for _, name in ipairs(seaMonsters) do
                        if obj.Name:find(name) then
                            local monsterPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if monsterPart and (monsterPart.Position - Root.Position).Magnitude < 300 then
                                isAvoidingEvent = true
                                Root.CFrame = Root.CFrame + Vector3.new(0, 200, 0)
                            end
                        end
                    end
                end
            end)
        end

        if _G.Config.AutoTravel ~= "" then
            local destName = _G.Config.AutoTravel
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("Travel", destName)
            end)
            _G.SenakaSendNotification("Di chuyển", "Đang tới: " .. destName)
            _G.Config.AutoTravel = ""
        end

        if not isAvoidingEvent then
            if _G.Config.IsMaster and Root and Hum and Hum.Health > 0 then
                local IceIsland = workspace:FindFirstChild("LeviathanIceIsland")
                local Heart = workspace:FindFirstChild("LeviathanHeart")
                
                if IceIsland then
                    local MyBoat = workspace:FindFirstChild(LocalPlayer.Name .. "_Boat")
                    
                    if not MyBoat then
                        if (Root.Position - _G.SenakaLocations.TikiBoat.Position).Magnitude > 50 then
                            _G.SenakaCharacterMove(_G.SenakaLocations.TikiBoat, _G.Config.TweenSpeed)
                            task.wait(0.3)
                        end
                        if _G.Config.AutoBuyBoat then SmartBuyBoat() end
                    else
                        for _, part in pairs(MyBoat:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end

                    if Heart then
                        pcall(function()
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("PullHeart")
                            _G.SenakaSendNotification("Leviathan", "Đang kéo tim về...")
                        end)
                    end
                else
                    if (Root.Position - _G.SenakaLocations.TikiBoat.Position).Magnitude > 100 then
                        _G.SenakaCharacterMove(_G.SenakaLocations.TikiBoat, _G.Config.TweenSpeed)
                    end
                end
            end

            if _G.Config.IsSlave and Root and Hum and Hum.Health > 0 then
                local MasterPlayer = nil
                pcall(function()
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and (p.Name:lower() == _G.Config.MasterName:lower() or p.DisplayName:lower() == _G.Config.MasterName:lower()) then
                            MasterPlayer = p
                            break
                        end
                    end
                end)

                if MasterPlayer and MasterPlayer.Character then
                    local MasterRoot = MasterPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if MasterRoot then
                        if not Hum.SeatPart then
                            local TargetSeat = nil
                            pcall(function()
                                for _, obj in pairs(workspace:GetDescendants()) do
                                    if (obj:IsA("VehicleSeat") or obj:IsA("Seat")) and not obj.Occupant then
                                        if (obj.Position - MasterRoot.Position).Magnitude < 150 then
                                            TargetSeat = obj
                                            break
                                        end
                                    end
                                end
                            end)

                            if TargetSeat then
                                pcall(function()
                                    Root.CFrame = TargetSeat.CFrame * CFrame.new(0, 2, 0)
                                    task.wait(0.1)
                                    TargetSeat:Sit(Hum)
                                end)
                            elseif (Root.Position - MasterRoot.Position).Magnitude > 15 then
                                _G.SenakaCharacterMove(MasterRoot.CFrame * CFrame.new(0, 3, -3), _G.Config.TweenSpeed)
                            end
                        end
                    end
                end
            end
        end

    end
end)

