local function AddToggleToPage(page, title, defaultVal, callback)
    local frame = Instance.new("Frame")
    frame.Parent = page
    frame.BackgroundColor3 = Color3.fromRGB(28, 28, 28)
    frame.Size = UDim2.new(1, -10, 0, 36)

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = frame

    local label = Instance.new("TextLabel")
    label.Parent = frame
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 10, 0, 0)
    label.Size = UDim2.new(0, 200, 1, 0)
    label.Font = Enum.Font.SourceSans
    label.Text = title
    label.TextColor3 = Color3.fromRGB(240, 240, 240)
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left

    local statusBox = Instance.new("TextButton")
    statusBox.Parent = frame
    statusBox.BackgroundColor3 = defaultVal and Color3.fromRGB(255, 180, 0) or Color3.fromRGB(50, 50, 50)
    statusBox.Position = UDim2.new(1, -45, 0.5, -11)
    statusBox.Size = UDim2.new(0, 36, 0, 22)
    statusBox.Font = Enum.Font.SourceSansBold
    statusBox.Text = defaultVal and "ON" or "OFF"
    statusBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    statusBox.TextSize = 11

    local boxCorner = Instance.new("UICorner")
    boxCorner.CornerRadius = UDim.new(0, 4)
    boxCorner.Parent = statusBox

    local val = defaultVal
    statusBox.MouseButton1Click:Connect(function()
        val = not val
        statusBox.BackgroundColor3 = val and Color3.fromRGB(255, 180, 0) or Color3.fromRGB(50, 50, 50)
        statusBox.Text = val and "ON" or "OFF"
        pcall(function() callback(val) end)
    end)
end

local function AddButtonToPage(page, title, callback)
    local btn = Instance.new("TextButton")
