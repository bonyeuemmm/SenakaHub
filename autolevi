-- TỐI ƯU HÓA BYPASS TELEPORT MƯỢT MÀ VÀ AN TOÀN
local function CharacterMove(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    speed = speed or _G.Config.TweenSpeed

    if _G.Config.BypassTeleport then
        local distance = (root.Position - targetCFrame.Position).Magnitude
        if distance < 3 then return end
        
        hum.PlatformStand = true
        
        -- Kích hoạt Noclip toàn diện để không bị kẹt địa hình
        local noclipConn
        noclipConn = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then 
                        part.CanCollide = false 
                    end
                end
            else
                if noclipConn then noclipConn:Disconnect() end
            end
        end)

        -- Sử dụng thuật toán lerp/tween tốc độ cao kết hợp triệt tiêu vận tốc vật lý gây văng
        local duration = math.clamp(distance / speed, 0.05, 0.8)
        local startTime = tick()
        local startCFrame = root.CFrame

        local connection
        connection = RunService.RenderStepped:Connect(function()
            local elapsed = tick() - startTime
            local alpha = math.clamp(elapsed / duration, 0, 1)
            
            if root and root.Parent then
                root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end

            if alpha >= 1 then
                if connection then connection:Disconnect() end
            end
        end)

        task.wait(duration)
        if connection then connection:Disconnect() end
        if noclipConn then noclipConn:Disconnect() end

        if hum and hum.Parent then hum.PlatformStand = false end
        if root and root.Parent then
            root.CFrame = targetCFrame
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        return
    end

    -- Chế độ di chuyển thường nếu tắt Bypass
    hum.PlatformStand = true
    local noclipConn = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = distance / speed
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})

    tween:Play()
    tween.Completed:Connect(function()
        if noclipConn then noclipConn:Disconnect() end
        if hum and hum.Parent then hum.PlatformStand = false end
    end)

    return tween
end

local function SmartBuyBoat()
    local boatList = {"Sleigh", "Mirage", "FlowerBoat", "Speedboat", "Dinghy"}
    for _, boat in ipairs(boatList) do
        local success, res = pcall(function()
            return ReplicatedStorage.Remotes.CommF_:InvokeServer("BuyBoat", boat)
        end)
        if success and res and res ~= "Failed" then
            SendNotification("Mua Thuyền", "Thành công: " .. boat)
            return true
        end
    end
    return false
end

spawn(function()
    while true do
        task.wait(0.4)
        
        local Char = LocalPlayer.Character
        local Hum = Char and Char:FindFirstChild("Humanoid")
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")

        if _G.Config.WaterWalk and Root then
            pcall(function()
                if Root.Position.Y < 5 and Root.Position.Y > -50 then
                    if not Root:FindFirstChild("WaterPlatform") then
                        local p = Instance.new("Part")
                        p.Name = "WaterPlatform"
                        p.Size = Vector3.new(12, 1, 12)
                        p.Anchored = true
                        p.Transparency = 1
                        p.CFrame = CFrame.new(Root.Position.X, 2, Root.Position.Z)
                        p.Parent = workspace
                        task.delay(0.5, function() if p then p:Destroy() end end)
                    end
                end
            end)
        end

        if _G.Config.AutoBuso and Char then
            pcall(function()
                if not Char:FindFirstChild("HasBuso") then
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
                end
            end)
        end

        if _G.Config.AutoV3V4 then
            pcall(function()
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Y, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Y, false, game)
                VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.T, false, game)
                VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.T, false, game)
            end)
        end

        -- Kiểm tra Sea Event: Đưa lên cao thông minh để né tránh nếu bật
        local isAvoidingEvent = false
        if _G.Config.AutoAvoidSeaEvent and Root then
            pcall(function()
                local seaMonsters = {"SeaBeast", "TerrorShark", "Piranha", "ShipRaid", "SeaMonster"}
                for _, obj in pairs(workspace:GetChildren()) do
                    for _, name in ipairs(seaMonsters) do
                        if obj.Name:find(name) then
                            local monsterPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            if monsterPart and (monsterPart.Position - Root.Position).Magnitude < 300 then
                                isAvoidingEvent = true
                                Root.CFrame = Root.CFrame + Vector3.new(0, 200, 0)
                            end
                        end
                    end
                end
            end)
        end

        if _G.Config.AutoTravel ~= "" then
            local destName = _G.Config.AutoTravel
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("Travel", destName)
            end)
            SendNotification("Di chuyển", "Đang tới: " .. destName)
            _G.Config.AutoTravel = ""
        end

        if not isAvoidingEvent then
            if _G.Config.IsMaster and Root and Hum and Hum.Health > 0 then
                local IceIsland = workspace:FindFirstChild("LeviathanIceIsland")
                local Heart = workspace:FindFirstChild("LeviathanHeart")
                
                if IceIsland then
                    local MyBoat = workspace:FindFirstChild(LocalPlayer.Name .. "_Boat")
                    
                    if not MyBoat then
                        if (Root.Position - TikiBoatCFrame.Position).Magnitude > 50 then
                            CharacterMove(TikiBoatCFrame, _G.Config.TweenSpeed)
                            task.wait(0.3)
                        end
                        if _G.Config.AutoBuyBoat then SmartBuyBoat() end
                    else
                        for _, part in pairs(MyBoat:GetDescendants()) do
                            if part:IsA("BasePart") then part.CanCollide = false end
                        end
                    end

                    if Heart then
                        pcall(function()
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("PullHeart")
                            SendNotification("Leviathan", "Đang tiến hành kéo tim về đích...")
                        end)
                    end
                else
                    if (Root.Position - TikiBoatCFrame.Position).Magnitude > 100 then
                        CharacterMove(TikiBoatCFrame, _G.Config.TweenSpeed)
                    end
                end
            end

            if _G.Config.IsSlave and Root and Hum and Hum.Health > 0 then
                local MasterPlayer = nil
                pcall(function()
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and (p.Name:lower() == _G.Config.MasterName:lower() or p.DisplayName:lower() == _G.Config.MasterName:lower()) then
                            MasterPlayer = p
                            break
                        end
                    end
                end)

                if MasterPlayer and MasterPlayer.Character then
                    local MasterRoot = MasterPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if MasterRoot then
                        if not Hum.SeatPart then
                            local TargetSeat = nil
                            pcall(function()
                                for _, obj in pairs(workspace:GetDescendants()) do
                                    if (obj:IsA("VehicleSeat") or obj:IsA("Seat")) and not obj.Occupant then
                                        if (obj.Position - MasterRoot.Position).Magnitude < 150 then
                                            TargetSeat = obj
                                            break
                                        end
                                    end
                                end
                            end)

                            if TargetSeat then
                                pcall(function()
                                    Root.CFrame = TargetSeat.CFrame * CFrame.new(0, 2, 0)
                                    task.wait(0.1)
                                    TargetSeat:Sit(Hum)
                                end)
                            elseif (Root.Position - MasterRoot.Position).Magnitude > 15 then
                                CharacterMove(MasterRoot.CFrame * CFrame.new(0, 3, -3), _G.Config.TweenSpeed)
                            end
                        end
                    end
                end
            end
        end

    end
end)

