local function FixBoatPhysics(boatModel)
    if not boatModel or anchoredBoats[boatModel] then return end
    anchoredBoats[boatModel] = true
    
    task.spawn(function()
        task.wait(0.5)
        pcall(function()
            for _, part in pairs(boatModel:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.Anchored = true
                end
            end
        end)
    end)
end

