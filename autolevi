local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local teamEvent = ReplicatedStorage:WaitForChild("ChooseTeam")
teamEvent:FireServer("Marines")

local boats = {
    "BasicBoat",
    "SpeedBoat",
    "LuxuryBoat",
    "Beast Hunter"
}

local selectedBoat = "Beast Hunter"
local masterEnabled = false
local index = 4

local gui = Instance.new("ScreenGui")
gui.Name = "SENAKA HUB 🍋 KAITUN LEVIATHAN"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local icon = Instance.new("ImageButton")
icon.Size = UDim2.fromOffset(65, 65)
icon.Position = UDim2.fromOffset(20, 100)
icon.BackgroundTransparency = 1
icon.Image = "rbxassetid://130284374965787"
icon.Parent = gui

local iconCorner = Instance.new("UICorner")
iconCorner.CornerRadius = UDim.new(1, 0)
iconCorner.Parent = icon

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(290, 220)
frame.Position = UDim2.fromOffset(20, 175)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
frame.Visible = false
frame.Parent = gui

local frameCorner = Instance.new("UICorner")
frameCorner.CornerRadius = UDim.new(0, 15)
frameCorner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, -20, 0, 45)
title.Position = UDim2.fromOffset(10, 5)
title.BackgroundTransparency = 1
title.Text = "🍋 SENAKA HUB"
title.TextSize = 22
title.Font = Enum.Font.GothamBold
title.TextXAlignment = Enum.TextXAlignment.Left
title.Parent = frame

local subtitle = Instance.new("TextLabel")
subtitle.Size = UDim2.new(1, -20, 0, 25)
subtitle.Position = UDim2.fromOffset(10, 45)
subtitle.BackgroundTransparency = 1
subtitle.Text = "KAITUN LEVIATHAN"
subtitle.TextSize = 13
subtitle.Font = Enum.Font.Gotham
subtitle.TextXAlignment = Enum.TextXAlignment.Left
subtitle.Parent = frame

local select = Instance.new("TextButton")
select.Size = UDim2.new(1, -30, 0, 45)
select.Position = UDim2.fromOffset(15, 80)
select.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
select.Text = "🚤  Thuyền: " .. selectedBoat
select.TextSize = 15
select.Font = Enum.Font.GothamSemibold
select.Parent = frame

local selectCorner = Instance.new("UICorner")
selectCorner.CornerRadius = UDim.new(0, 10)
selectCorner.Parent = select

local master = Instance.new("TextButton")
master.Size = UDim2.new(1, -30, 0, 45)
master.Position = UDim2.fromOffset(15, 135)
master.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
master.Text = "👑  MASTER • OFF"
master.TextSize = 15
master.Font = Enum.Font.GothamSemibold
master.Parent = frame

local masterCorner = Instance.new("UICorner")
masterCorner.CornerRadius = UDim.new(0, 10)
masterCorner.Parent = master

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -30, 0, 25)
status.Position = UDim2.fromOffset(15, 190)
status.BackgroundTransparency = 1
status.Text = "⚓ Marines • Ready"
status.TextSize = 12
status.Font = Enum.Font.Gotham
status.TextXAlignment = Enum.TextXAlignment.Left
status.Parent = frame

icon.MouseButton1Click:Connect(function()
    frame.Visible = not frame.Visible
end)

select.MouseButton1Click:Connect(function()
    index += 1

    if index > #boats then
        index = 1
    end

    selectedBoat = boats[index]
    select.Text = "🚤  Thuyền: " .. selectedBoat
end)

master.MouseButton1Click:Connect(function()
    masterEnabled = not masterEnabled

    if masterEnabled then
        master.Text = "👑  MASTER • ON"
        status.Text = "⚓ Marines • " .. selectedBoat
    else
        master.Text = "👑  MASTER • OFF"
        status.Text = "⚓ Marines • Ready"
    end
end)