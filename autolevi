                if root.Position.Y <= 30 and root.Position.Y >= -100 then
                    WaterPlatform.CFrame = CFrame.new(root.Position.X, 3, root.Position.Z)
                    WaterPlatform.CanCollide = true
                else
                    WaterPlatform.CanCollide = false
                end
            else
                WaterPlatform.CanCollide = false
            end
        end)
    else
        WaterPlatform.CanCollide = false
    end
end)

