    btn.Parent = TabBar
    btn.BackgroundTransparency = 1
    btn.Size = UDim2.new(0.5, -2, 1, 0)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(160, 145, 110)
    btn.TextSize = 12

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 6)
    btnCorner.Parent = btn

    if targetPage == pageMain then
        btn.BackgroundTransparency = 0
        btn.BackgroundColor3 = Color3.fromRGB(45, 38, 22)
        btn.TextColor3 = Color3.fromRGB(255, 230, 150)
    end

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(Pages) do p.Visible = false end
        for _, b in pairs(TabButtons) do
            b.BackgroundTransparency = 1
            b.TextColor3 = Color3.fromRGB(160, 145, 110)
        end
        targetPage.Visible = true
        btn.BackgroundTransparency = 0
        btn.BackgroundColor3 = Color3.fromRGB(45, 38, 22)
        btn.TextColor3 = Color3.fromRGB(255, 230, 150)
    end)

    table.insert(TabButtons, btn)
end

