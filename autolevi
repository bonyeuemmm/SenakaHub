local boatFlightState = "Idle" 

task.spawn(function()
    while task.wait(0.5) do
        local Char = LocalPlayer.Character
        local Hum = Char and Char:FindFirstChild("Humanoid")
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")

        if _G.Config.AutoGetSanguineArt and Root and Hum and Hum.Health > 0 then
            local enemyTarget = nil
            if workspace:FindFirstChild("Enemies") then
                for _, mob in pairs(workspace.Enemies:GetChildren()) do
                    local mobRoot = mob:FindFirstChild("HumanoidRootPart")
                    local mobHum = mob:FindFirstChild("Humanoid")
                    if mobRoot and mobHum and mobHum.Health > 0 then
                        if (mob.Name:find("Vampire") or mob.Name:find("TerrorShark") or mob.Name:find("FishTail") or mob.Name:find("Demonic")) then
                            if (mobRoot.Position - Root.Position).Magnitude < 2000 then
                                enemyTarget = mobRoot
                                break
                            end
                        end
                    end
                end
            end

            if enemyTarget then
                Root.CFrame = enemyTarget.CFrame * CFrame.new(0, 5, 3)
                pcall(function()
                    if VirtualInputManager then
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
                    end
                end)
            end
        end

        if not _G.Config.AutoGetSanguineArt then
            if _G.Config.IsMaster and Root and Hum and Hum.Health > 0 then
                local IceIsland = workspace:FindFirstChild("LeviathanIceIsland")
                local Heart = workspace:FindFirstChild("LeviathanHeart")
                local distToTiki = (Root.Position - _G.SenakaLocations.TikiBoat.Position).Magnitude
                
                if distToTiki > 150 and not GetPlayerBoat() and not IceIsland then
                    _G.SenakaCharacterMove(_G.SenakaLocations.TikiBoat, _G.Config.TweenSpeed)
                    boatFlightState = "Idle"
                else
                    local myBoat = GetPlayerBoat()
                    if not myBoat then
                        FindAndInteractBoatDealer()
                        boatFlightState = "Idle"
                    else
                        SecureBoatPhysics(myBoat)
                        
                        if not Hum.SeatPart then
                            local targetSeat = nil
                            for _, d in pairs(myBoat:GetDescendants()) do
                                if d:IsA("VehicleSeat") and not d.Occupant then
                                    targetSeat = d
                                    break
                                end
                            end
                            if not targetSeat then
                                for _, d in pairs(myBoat:GetDescendants()) do
                                    if d:IsA("Seat") and not d.Occupant then
                                        targetSeat = d
                                        break
                                    end
                                end
                            end

                            if targetSeat then
                                Hum.PlatformStand = false
                                Root.CFrame = targetSeat.CFrame
                                task.wait(0.3)
                                pcall(function() targetSeat:Sit(Hum) end)
                            else
                                local boatPart = myBoat.PrimaryPart or myBoat:FindFirstChildWhichIsA("BasePart")
                                if boatPart and (Root.Position - boatPart.Position).Magnitude > 15 then
                                    Root.CFrame = boatPart.CFrame + Vector3.new(0, 5, 0)
                                end
                            end
                        else
                            if CountPlayersOnBoat(myBoat) >= 5 then
                                if IceIsland then
                                    local islandPart = IceIsland:FindFirstChild("PrimaryPart") or IceIsland:FindFirstChildWhichIsA("BasePart")
                                    if islandPart then
                                        if (Root.Position - islandPart.Position).Magnitude > 150 then
                                            _G.SenakaCharacterMove(islandPart.CFrame * CFrame.new(0, 20, 0), _G.Config.TweenSpeed)
                                        else
                                            _G.SenakaCharacterMove(_G.SenakaLocations.SpyNpc, _G.Config.TweenSpeed)
                                            task.wait(0.5)
                                            pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("FindLeviathan") end)
                                        end
                                    end
                                    if Heart then pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("PullHeart") end) end
                                else
                                    local boatPrimary = myBoat.PrimaryPart or myBoat:FindFirstChildWhichIsA("BasePart")
                                    if boatPrimary then
                                        local distanceToSea = (boatPrimary.Position - _G.SenakaLocations.SeaSearchCenter.Position).Magnitude
                                        
                                        if boatFlightState == "Idle" then
                                            local highTarget = CFrame.new(boatPrimary.Position.X, 150, boatPrimary.Position.Z)
                                            local upTween = TweenService:Create(boatPrimary, TweenInfo.new(1.5, Enum.EasingStyle.Linear), {CFrame = highTarget})
                                            upTween:Play()
                                            upTween.Completed:Wait()
                                            boatFlightState = "FlyingToSea"
                                        elseif boatFlightState == "FlyingToSea" then
                                            if distanceToSea > 300 then
                                                local highSeaTarget = CFrame.new(_G.SenakaLocations.SeaSearchCenter.Position.X, 150, _G.SenakaLocations.SeaSearchCenter.Position.Z)
                                                local duration = (boatPrimary.Position - highSeaTarget.Position).Magnitude / (_G.Config.BoatTweenSpeed or 350)
                                                local seaTween = TweenService:Create(boatPrimary, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = highSeaTarget})
                                                seaTween:Play()
                                                seaTween.Completed:Wait()
                                            end
                                            boatFlightState = "Lowering"
                                        elseif boatFlightState == "Lowering" then
                                            local lowSeaTarget = CFrame.new(_G.SenakaLocations.SeaSearchCenter.Position.X, 5, _G.SenakaLocations.SeaSearchCenter.Position.Z)
                                            local downTween = TweenService:Create(boatPrimary, TweenInfo.new(1, Enum.EasingStyle.Linear), {CFrame = lowSeaTarget})
                                            downTween:Play()
                                            downTween.Completed:Wait()
                                            boatFlightState = "Searching"
                                        elseif boatFlightState == "Searching" then
                                            pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("FindLeviathan") end)
                                        end
                                    end
                                end
                            else
                                boatFlightState = "Idle"
                            end
                        end
                    end
                end
            end

            if _G.Config.IsSlave and Root and Hum and Hum.Health > 0 then
                local MasterPlayer = nil
                local foundMaster = false
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and (p.Name:lower() == _G.Config.MasterName:lower() or p.DisplayName:lower() == _G.Config.MasterName:lower()) then
                        MasterPlayer = p
                        foundMaster = true
                        break
                    end
                end
                
                if not foundMaster and _G.Config.MasterName ~= "" then
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer then
                            MasterPlayer = p
                            break
                        end
                    end
                end

                if MasterPlayer and MasterPlayer.Character then
                    local MasterRoot = MasterPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if MasterRoot and not Hum.SeatPart then
                        local TargetSeat = nil
                        local masterBoat = GetPlayerBoat()
                        if masterBoat then
                            for _, d in pairs(masterBoat:GetDescendants()) do
                                if (d:IsA("Seat") or d:IsA("VehicleSeat")) and not d.Occupant then
                                    TargetSeat = d
                                    break
                                end
                            end
                        end

                        if TargetSeat then
                            Hum.PlatformStand = false
                            Root.CFrame = TargetSeat.CFrame
                            task.wait(0.3)
                            pcall(function() TargetSeat:Sit(Hum) end)
                        else
                            if (Root.Position - MasterRoot.Position).Magnitude > 20 then
                                Root.CFrame = MasterRoot.CFrame * CFrame.new(0, 0, 5)
                            end
                        end
                    end
                end
            end
        end
    end
end)
