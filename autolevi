    local textBox = Instance.new("TextBox")
    textBox.Parent = frame
    textBox.BackgroundColor3 = Color3.fromRGB(18, 16, 12)
    textBox.Position = UDim2.new(0, 12, 0, 26)
    textBox.Size = UDim2.new(1, -24, 0, 22)
