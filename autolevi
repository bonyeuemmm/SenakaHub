task.spawn(function()
    while task.wait(0.5) do
        local Char = LocalPlayer.Character
        local Hum = Char and Char:FindFirstChild("Humanoid")
        local Root = Char and Char:FindFirstChild("HumanoidRootPart")

        if not _G.Config.AutoGetSanguineArt then
            if _G.Config.IsMaster and Root and Hum and Hum.Health > 0 then
                local IceIsland = workspace:FindFirstChild("LeviathanIceIsland")
                local Heart = workspace:FindFirstChild("LeviathanHeart")
                
                if IceIsland then
                    local islandPart = IceIsland:FindFirstChild("PrimaryPart") or IceIsland:FindFirstChildWhichIsA("BasePart")
                    if islandPart then
                        if (Root.Position - islandPart.Position).Magnitude > 150 then
                            _G.SenakaCharacterMove(islandPart.CFrame * CFrame.new(0, 20, 0), _G.Config.TweenSpeed)
                        else
                            _G.SenakaCharacterMove(_G.SenakaLocations.SpyNpc, _G.Config.TweenSpeed)
                            task.wait(0.5)
                            pcall(function()
                                ReplicatedStorage.Remotes.CommF_:InvokeServer("FindLeviathan")
                            end)
                        end
                    end

                    if Heart then
                        pcall(function()
                            ReplicatedStorage.Remotes.CommF_:InvokeServer("PullHeart")
                        end)
                    end
                else
                    local myBoat = GetPlayerBoat()
                    if not myBoat then
                        if (Root.Position - _G.SenakaLocations.TikiBoat.Position).Magnitude > 40 then
                            _G.SenakaCharacterMove(_G.SenakaLocations.TikiBoat, _G.Config.TweenSpeed)
                        else
                            if _G.Config.AutoBuyBoat then 
                                SmartBuyBoat() 
                            end
                        end
                    else
                        SecureBoatPhysics(myBoat)
                        if not Hum.SeatPart then
                            local targetSeat = nil
                            for _, d in pairs(myBoat:GetDescendants()) do
                                if (d:IsA("VehicleSeat") or d:IsA("Seat")) and not d.Occupant then
                                    targetSeat = d
                                    break
                                end
                            end
                            if targetSeat then
                                Root.CFrame = targetSeat.CFrame + Vector3.new(0, 3, 0)
                                task.wait(0.2)
                                targetSeat:Sit(Hum)
                            end
                        end
                    end
                end
            end

            if _G.Config.IsSlave and Root and Hum and Hum.Health > 0 then
                local MasterPlayer = nil
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and (p.Name:lower() == _G.Config.MasterName:lower() or p.DisplayName:lower() == _G.Config.MasterName:lower()) then
                        MasterPlayer = p
                        break
                    end
                end

                if MasterPlayer and MasterPlayer.Character then
                    local MasterRoot = MasterPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if MasterRoot then
                        if not Hum.SeatPart then
                            local TargetSeat = nil
                            for _, obj in pairs(workspace:GetDescendants()) do
                                if (obj:IsA("VehicleSeat") or obj:IsA("Seat")) and not obj.Occupant then
                                    if (obj.Position - MasterRoot.Position).Magnitude < 100 then
                                        TargetSeat = obj
                                        break
                                    end
                                end
                            end

                            if TargetSeat then
                                Root.CFrame = TargetSeat.CFrame * CFrame.new(0, 2, 0)
                                task.wait(0.2)
                                TargetSeat:Sit(Hum)
                            elseif (Root.Position - MasterRoot.Position).Magnitude > 20 then
                                _G.SenakaCharacterMove(MasterRoot.CFrame * CFrame.new(0, 3, -3), _G.Config.TweenSpeed)
                            end
                        end
                    end
                end
            end
        end
    end
end)
