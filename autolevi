pcall(function()
    local targetParent = gethui and gethui() or CoreGui
    if targetParent:FindFirstChild("SenakaToggleIcon") then
        targetParent.SenakaToggleIcon:Destroy()
    end

    local sg = Instance.new("ScreenGui")
    sg.Name = "SenakaToggleIcon"
    sg.ResetOnSpawn = false
    sg.Parent = targetParent
    
    local btn = Instance.new("TextButton")
    btn.Name = "ToggleButton"
    btn.Size = UDim2.new(0, 50, 0, 50)
    btn.Position = UDim2.new(0, 15, 0.4, 0)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
    btn.Text = "MENU"
    btn.TextColor3 = Color3.fromRGB(255, 204, 0)
    btn.TextSize = 12
    btn.Font = Enum.Font.SourceSansBold
    btn.Active = true
    btn.Draggable = true
    btn.Parent = sg
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 204, 0)
    stroke.Thickness = 2
    stroke.Parent = btn

    local isOpen = true
    btn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        pcall(function()
            if isOpen then
                _G.SenakaWindow:Unpack()
            else
                _G.SenakaWindow:Minimize()
            end
        end)
        btn.Text = isOpen and "HIDE" or "SHOW"
    end)
end)

_G.SenakaSendNotification = function(title, content, duration)
    pcall(function()
        Fluent:Notify({ Title = title, Content = content, Duration = duration or 3 })
    end)
end

local WaterPlatform = Instance.new("Part")
WaterPlatform.Name = "SenakaWaterPlatform"
WaterPlatform.Size = Vector3.new(100, 1, 100)
WaterPlatform.Anchored = true
WaterPlatform.Transparency = 1
WaterPlatform.CanCollide = false
WaterPlatform.Parent = workspace

RunService.Stepped:Connect(function()
    if _G.Config.WaterWalk then
        pcall(function()
            local char = LocalPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root then
                if root.Position.Y <= 20 and root.Position.Y >= -100 then
                    WaterPlatform.CFrame = CFrame.new(root.Position.X, 1, root.Position.Z)
                    WaterPlatform.CanCollide = true
                else
                    WaterPlatform.CanCollide = false
                end
            end
        end)
    else
        WaterPlatform.CanCollide = false
    end
end)

