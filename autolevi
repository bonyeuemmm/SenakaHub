_G.SenakaCharacterMove = function(targetCFrame, speed)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not root or not hum then return end

    speed = speed or _G.Config.TweenSpeed

    if not _G.Config.IsMaster and not _G.Config.IsSlave and _G.Config.AutoTravel == "" then
        hum.PlatformStand = false
        return
    end

    if _G.Config.BypassTeleport then
        local distance = (root.Position - targetCFrame.Position).Magnitude
        if distance < 3 then return end
        
        hum.PlatformStand = true
        
        local noclipConn = RunService.Stepped:Connect(function()
            if char and char.Parent then
                for _, part in pairs(char:GetChildren()) do
                    if part:IsA("BasePart") then part.CanCollide = false end
                end
            end
        end)

        local duration = math.clamp(distance / speed, 0.05, 0.8)
        local startTime = tick()
        local startCFrame = root.CFrame

        local connection
        connection = RunService.RenderStepped:Connect(function()
            if (not _G.Config.IsMaster and not _G.Config.IsSlave and _G.Config.AutoTravel == "") or not _G.Config.BypassTeleport then
                if connection then connection:Disconnect() end
                if noclipConn then noclipConn:Disconnect() end
                hum.PlatformStand = false
                return
            end

            local elapsed = tick() - startTime
            local alpha = math.clamp(elapsed / duration, 0, 1)
            
            if root and root.Parent then
                root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end

            if alpha >= 1 then
                if connection then connection:Disconnect() end
            end
        end)

        task.wait(duration)
        if connection then connection:Disconnect() end
        if noclipConn then noclipConn:Disconnect() end

        if hum and hum.Parent then hum.PlatformStand = false end
        if root and root.Parent then
            root.CFrame = targetCFrame
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end
        return
    end

    hum.PlatformStand = true
    local noclipConn = RunService.Stepped:Connect(function()
        if char and char.Parent then
            for _, part in pairs(char:GetChildren()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end
    end)

    local distance = (root.Position - targetCFrame.Position).Magnitude
    local duration = distance / speed
    local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = targetCFrame})

    tween:Play()
    tween.Completed:Connect(function()
        if noclipConn then noclipConn:Disconnect() end
        if hum and hum.Parent then hum.PlatformStand = false end
    end)
    return tween
end
