local function FullClearFog()
    Lighting.FogStart = 0
    Lighting.FogEnd = 9e9
    Lighting.GlobalShadows = false
    Lighting.Brightness = 2
    for _, v in pairs(Lighting:GetChildren()) do
        if v:IsA("Atmosphere") or v:IsA("PostEffect") or v:IsA("DepthOfFieldEffect") or v:IsA("BloomEffect") or v:IsA("SunRaysEffect") then
            v:Destroy()
        end
    end
end

