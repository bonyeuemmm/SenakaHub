_G.SenakaCharacterMove = function(targetPosition, speed)
    pcall(function()
        local character = LocalPlayer.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local hrp = character.HumanoidRootPart
        local distance = (hrp.Position - targetPosition).Magnitude
        local timeTaken = distance / speed
        
        local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear)
        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(targetPosition)})
        tween:Play()
        
        _G.CancelMove = function()
            tween:Cancel()
        end
    end)
end

_G.SenakaBoatMove = function(targetPosition, speed)
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        
        for _, boat in pairs(Workspace.Boats:GetChildren()) do
            local owner = boat:FindFirstChild("Owner")
            if owner and owner.Value == LocalPlayer then
                local boatPart = boat:FindFirstChild("RootPart") or boat:FindFirstChild("Hull")
                if boatPart then
                    local distance = (boatPart.Position - targetPosition).Magnitude
                    local timeTaken = distance / speed
                    local tweenInfo = TweenInfo.new(timeTaken, Enum.EasingStyle.Linear)
                    local tween = TweenService:Create(boatPart, tweenInfo, {CFrame = CFrame.new(targetPosition)})
                    tween:Play()
                end
            end
        end
    end)
end
task.spawn(function()
    while task.wait(0.5) do
        pcall(function()
            local cfg = _G.Config
            local char = LocalPlayer.Character
            if not char then return end

            if cfg.AutoBuso then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and not char:FindFirstChild("Buso") then
                    local vim = game:GetService("VirtualInputManager")
                    vim:SendKeyEvent(true, Enum.KeyCode.J, false, game)
                    vim:SendKeyEvent(false, Enum.KeyCode.J, false, game)
                end
            end

            if cfg.WaterWalk then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp and hrp.Position.Y < -5 then
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
                end
            end

            if cfg.IsMaster then
                if cfg.AutoPullHeartToTiki then
                    _G.SenakaBoatMove(_G.SenakaLocations.TikiBoat, cfg.BoatTweenSpeed)
                elseif cfg.AutoPullHeartToHydra then
                    _G.SenakaBoatMove(_G.SenakaLocations.Hydra, cfg.BoatTweenSpeed)
                end
            elseif cfg.IsSlave and cfg.MasterName ~= "" then
                local masterPlayer = Players:FindFirstChild(cfg.MasterName)
                if masterPlayer and masterPlayer.Character and masterPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local masterPos = masterPlayer.Character.HumanoidRootPart.Position
                    local hrp = char:FindFirstChild("HumanoidRootPart")
                    if hrp and (hrp.Position - masterPos).Magnitude > 20 then
                        _G.SenakaCharacterMove(masterPos + Vector3.new(0, 5, -5), cfg.TweenSpeed)
                    end
                end
            end

            if cfg.AutoAvoidSeaEvent then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    for _, v in pairs(Workspace.Enemies:GetChildren()) do
                        if v:FindFirstChild("HumanoidRootPart") and (v.HumanoidRootPart.Position - hrp.Position).Magnitude < 300 then
                            hrp.CFrame = hrp.CFrame + Vector3.new(0, 150, 0)
                        end
                    end
                end
            end
        end)
    end
end)
