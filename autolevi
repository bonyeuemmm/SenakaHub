local function InitAntiBanSystem()
    pcall(function()
        local rawMeta = getrawmetatable(game)
        if setreadonly then setreadonly(rawMeta, false) end
        
        local oldNamecall = rawMeta.__namecall
        rawMeta.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local nameStr = tostring(self)
                if nameStr:find("Ban") or nameStr:find("Check") or nameStr:find("Admin") or nameStr:find("Detection") then
                    return nil
                end
            end
            if method == "Kick" or method == "kick" then
                return nil
            end
            return oldNamecall(self, ...)
        end)
        
        if setreadonly then setreadonly(rawMeta, true) end
    end)

    pcall(function()
        if getgenv then getgenv().AntiCheatBypass = true end
        for _, v in pairs(getgc(true)) do
            if type(v) == "table" and rawget(v, "Detected") then
                v.Detected = function() return end
            end
        end
    end)
end

