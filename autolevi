local Players = game:GetService("Players")

local player = Players.LocalPlayer

local boats = {
    "BasicBoat",
    "SpeedBoat",
    "LuxuryBoat"
}

local selectedBoat = boats[1]
local masterEnabled = false
local menuOpen = false
local index = 1

local gui = Instance.new("ScreenGui")
gui.Name = "SENAKA HUB 🍋 KAITUN LEVIATHAN"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local icon = Instance.new("ImageButton")
icon.Size = UDim2.fromOffset(55, 55)
icon.Position = UDim2.fromOffset(20, 100)
icon.BackgroundTransparency = 1
icon.Image = "rbxassetid://130284374965787"
icon.Parent = gui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(240, 190)
frame.Position = UDim2.fromOffset(20, 165)
frame.Visible = false
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.Text = "SENAKA HUB 🍋 KAITUN LEVIATHAN"
title.Parent = frame

local select = Instance.new("TextButton")
select.Size = UDim2.new(1, -20, 0, 40)
select.Position = UDim2.fromOffset(10, 50)
select.Text = "Thuyền: " .. selectedBoat
select.Parent = frame

local master = Instance.new("TextButton")
master.Size = UDim2.new(1, -20, 0, 40)
master.Position = UDim2.fromOffset(10, 100)
master.Text = "Master: OFF"
master.Parent = frame

icon.MouseButton1Click:Connect(function()
    menuOpen = not menuOpen
    frame.Visible = menuOpen
end)

select.MouseButton1Click:Connect(function()
    index += 1

    if index > #boats then
        index = 1
    end

    selectedBoat = boats[index]
    select.Text = "Thuyền: " .. selectedBoat
end)

master.MouseButton1Click:Connect(function()
    masterEnabled = not masterEnabled

    if masterEnabled then
        master.Text = "Master: ON"
        print("Master ON - " .. selectedBoat)
    else
        master.Text = "Master: OFF"
        print("Master OFF")
    end
end)